# Copy this file to local.auto.tfvars and replace the registration code.
aws_max_retries = 5
aws_retry_mode  = "standard"
# local.auto.tfvars is ignored by Git and loaded automatically by Terraform.

aws_region        = "eu-west-3"
availability_zone = "eu-west-3b"
ai_services_availability_zone = "eu-west-3b"
registration_code = "REPLACE_WITH_FRESH_16_CHARACTER_CODE"

# Optional overrides for deployments/aws-ami-catalog.json:
# prod_ami_id = "ami-0123456789abcdef0"
# dev_ami_id  = "ami-0123456789abcdef0"

management_cidrs = ["180.150.42.155/32"]
s3_bucket_name   = "zoomnode-paris-labcluster-s3"

meetings_hybrid_instance_type   = "c8i-flex.2xlarge"
kubernetes_master_instance_type = "c7i-flex.xlarge"
kubernetes_worker_instance_type = "c8i.4xlarge"
ai_services_instance_type       = "g6.12xlarge"
